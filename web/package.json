{
  "name": "cloud-control-panel-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "gen": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "dev": "pnpm gen && vite",
